<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:label="AI Call UI"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".CallTriggerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.johnnydev.SHOW_CALL" />
                <action android:name="com.johnnydev.ONGOING_CALL" />
                <action android:name="com.johnnydev.HIDE_CALL" />
                <action android:name="com.johnnydev.BTN_ANSWER" />
                <action android:name="com.johnnydev.BTN_DECLINE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
